# API Keys for LLM Providers
# Copy this file to .env and fill in your actual API keys
# Keys will be automatically loaded into the OS keychain on first run (dev mode only)

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Perplexity AI
PERPLEXITY_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# Cerebras
CEREBRAS_API_KEY=

# Note: Ollama and LM Studio are local providers and don't require API keys
